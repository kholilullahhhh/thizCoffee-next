# PostgreSQL connection string. Required on Netlify/production.
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Optional connection pool size (default 5)
DATABASE_POOL_MAX=5

# Local development without DATABASE_URL uses embedded PGlite in .data/pglite.
# Override the local data directory if needed:
# PGLITE_DATA_DIR=.data/pglite

# Optional: change the development seed password (default: thizcoffee123)
# SEED_DEMO_PASSWORD=

# Optional: allow demo seeding when NODE_ENV=production/NETLIFY=true.
# Leave unset in production. Set to true only for an intentional demo deploy.
# SEED_DEMO=

# Production bootstrap only, used by npm run db:create-admin
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=use-a-long-random-password
# ADMIN_NAME=Owner Thiz Coffee
