# Neon PostgreSQL deployment template.
# Copy the values from Neon Dashboard → Project → Connect.
# This file is a safe template; never commit real credentials.

# Runtime connection for Netlify Functions.
# Neon "Pooled connection" host contains "-pooler".
DATABASE_URL=postgresql://neondb_owner:npg_QV4bwd1NksnS@ep-frosty-smoke-aohbrj3k-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Direct connection for migrations and admin bootstrap.
# Neon "Direct connection" host does not contain "-pooler".
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_QV4bwd1NksnS@ep-frosty-smoke-aohbrj3k.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# Keep this small on serverless hosting. Neon pooled connections also have a limit.
DATABASE_POOL_MAX=3

# Only used by: npm run db:create-admin
# Use a long, unique password. Do not use the demo password.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-password
# ADMIN_NAME=Owner Thiz Coffee

# Never enable demo seeding for the production database.
# SEED_DEMO=
